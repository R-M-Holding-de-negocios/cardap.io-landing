NEXT_PUBLIC_SAAS_URL=http://localhost:3000
PLATFORM_API_URL=http://localhost:8787
# The server proxies registration and portal requests to the Cloudflare API.
# In Vercel Preview, set this to the HTTPS API of homologation. Production needs its own production API.
# Optional: preview the public social tags in this isolated landing build.
# NEXT_PUBLIC_SITE_URL=https://mycardap.io
# Segredo entre este site e a API (32+ caracteres), igual ao SITE_PROXY_SECRET da API.
# Fora do desenvolvimento a API só atende admin, afiliado, candidatura e cadastro com ele.
SITE_PROXY_SECRET=
# Em produção PLATFORM_API_URL exige https, exceto para 127.0.0.1, localhost e [::1] (API na mesma VPS).
# Em localhost os cookies não distinguem porta: site (3001) e sistema (3000) enxergam os cookies um do outro.
